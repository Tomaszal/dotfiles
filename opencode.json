{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["mcp-nixos"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/nix/store/**": "allow"
    },
    "read": {
      "/nix/store/**": "allow"
    },
    "list": {
      "/nix/store/**": "allow"
    }
  }
}
